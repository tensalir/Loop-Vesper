# =============================================================================
# Loop-Vesper Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local with real credentials to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required for Authentication)
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Database Connection (Required)
# -----------------------------------------------------------------------------
# Get from: Supabase Dashboard → Settings → Database → Connection String
# For Vercel/serverless: Use Transaction pooler (port 6543) with ?pgbouncer=true
# For local development: Can use direct connection (port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# -----------------------------------------------------------------------------
# Application URL
# -----------------------------------------------------------------------------
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production (Vercel), set this to your deployed URL:
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# AI Model API Keys
# -----------------------------------------------------------------------------

# Google Gemini API Key (for Nano Banana and Veo models)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# FAL.ai API Key (for Seedream v4 Edit and other FAL models)
# Get from: https://fal.ai/dashboard/keys
FAL_API_KEY=your-fal-api-key-here

# Replicate API Token (for Seedream 4)
# Get from: https://replicate.com/account/api-tokens
# Token starts with "r8_"
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# OpenAI API Key (for GPT Image 2)
# Get from: https://platform.openai.com/api-keys
# Requires API Organization Verification for GPT Image models:
# https://help.openai.com/en/articles/10910291-api-organization-verification
OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Background Queue Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable/disable the generation queue (set to false for legacy fire-and-forget)
GENERATION_QUEUE_ENABLED=true
GENERATION_QUEUE_BATCH_SIZE=5
GENERATION_QUEUE_LOCK_TIMEOUT_MS=60000
GENERATION_QUEUE_RETRY_DELAY_MS=30000

# -----------------------------------------------------------------------------
# Internal API Security (Recommended for Production)
# -----------------------------------------------------------------------------
# For secure server-to-server API calls (e.g., background processing).
# This secret is INTENDED FOR INTERNAL WORKER PATHS ONLY. It bypasses
# user-level resource checks on trusted routes and must NEVER be shared
# with external integrators. External callers use scoped headless
# credentials (`vsp_live_*`) issued via /api/admin/headless-credentials.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-random-secret-string-here

# -----------------------------------------------------------------------------
# Headless Vesper API + MCP (Optional)
# -----------------------------------------------------------------------------
# Override the Anthropic models used by the iteration slate endpoint and
# the prompt enhancement endpoint. Defaults are sensible for production.
# ANTHROPIC_PROMPT_ENHANCE_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_PROMPT_ITERATE_MODEL=claude-sonnet-4-5-20250929
# See: docs/headless-vesper.md
#
# The /headless landing page itself does not need any env vars: access
# is gated by Supabase auth + the per-user `headlessAccess` flag on
# `Profile` (toggle from User Management settings).

# -----------------------------------------------------------------------------
# Webhook Verification Secrets (Optional but Recommended)
# -----------------------------------------------------------------------------
# Replicate: set in Replicate webhook settings to verify signatures
# REPLICATE_WEBHOOK_SECRET=whsec_your-replicate-webhook-secret

# Figma: passcode set when creating the Figma webhook
# FIGMA_WEBHOOK_PASSCODE=your-figma-webhook-passcode

# Monday.com: signing secret from Monday webhook configuration
# MONDAY_WEBHOOK_SECRET=your-monday-signing-secret

# -----------------------------------------------------------------------------
# Rate Limit Configuration (Optional - Tier 3 defaults are now built-in)
# -----------------------------------------------------------------------------
# Override the default Tier 3 limits if needed.
# See: https://ai.google.dev/gemini-api/docs/rate-limits
#
# Gemini global limits (Tier 3 defaults: 1000 RPM, 50000/month)
# GEMINI_RPM=1000
# GEMINI_MONTHLY=50000
#
# Nano Banana (Gemini 2.5 Flash Image) - Tier 3 defaults: 500 RPM, 30000/month
# GEMINI_NANO_BANANA_RPM=500
# GEMINI_NANO_BANANA_MONTHLY=30000
#
# Veo 3.1 (Video) - Tier 3 defaults: 100 RPM, 5000/month
# GEMINI_VEO_RPM=100
# GEMINI_VEO_MONTHLY=5000
#
# Replicate limits (generous defaults: 100 RPM)
# REPLICATE_RPM=100
# REPLICATE_MONTHLY=10000

# =============================================================================
# MCP connector (headless surface)
# =============================================================================
# How long a generate_asset / generate_video call waits before handing back a
# job id to collect with get_generation_status (ms). Callers that cannot poll
# (the org token) always wait to the end.
# MCP_SYNC_BUDGET_MS=50000
#
# Vercel sends this as `Authorization: Bearer ...` to /api/cron/mcp-jobs, the
# per-minute sweeper that fails stale jobs and runs leftover queued ones, and to
# /api/cron/oauth-cleanup, the daily purge of spent sign-in codes and tokens.
# CRON_SECRET=
#
# Per-person sign-in for the Claude connector (OAuth 2.1). Without a secret of
# at least 32 characters the sign-in is off and only vsp_live_ tokens work.
# Generate one with `openssl rand -base64 48`; use a different one on Preview.
# MCP_OAUTH_SECRET=
# `0` switches the sign-in off (register, authorize and token answer 503);
# existing access tokens run out within the hour, static tokens keep working.
# MCP_OAUTH_ENABLED=1
# Extra redirect URIs a client may register, comma-separated, exact match.
# Claude's callbacks and loopback addresses are always allowed.
# MCP_OAUTH_REDIRECT_ALLOWLIST=
# `1` accepts client ids that are https URLs of a client metadata document
# on the hosts in MCP_OAUTH_CIMD_HOSTS (comma-separated).
# MCP_OAUTH_CIMD=0
# MCP_OAUTH_CIMD_HOSTS=
# Other resource URLs this server answers to (a second domain in front of the
# same deployment), comma-separated.
# MCP_RESOURCE_ALIASES=
#
# Daily spend cap per person for paid MCP calls, in USD. Unset or 0 = no cap.
# Counted per credential owner: set it once people sign in one by one, since
# every colleague on the shared org token counts against its issuing admin.
# MCP_DAILY_COST_CAP_USD=25
#
# Extra hosts the MCP tools may fetch caller-supplied reference URLs from,
# comma-separated; `*.example.com` matches subdomains. Vesper's Supabase host,
# Frontify and Replicate delivery are always allowed.
# VESPER_FETCH_ALLOWLIST=
#
# CMF Studio: 1 restores the model rewrite of the code-built prompt and the
# lighting that rotates per attempt. Off by default since 2026-09-24.
# CMF_LEGACY_PROMPTING=0
#
# The Loop creative kit (the Loop Creative plugin's kit.json, read at its
# creative-v<version> release tag) and its pinned references.
# Vesper's GitHub App, installed on the plugin repository only, with
# Contents: read, Issues: read and write, Metadata: read.
# GITHUB_APP_ID=
# The App's private key, the whole PEM base64-encoded on one line.
# GITHUB_APP_PRIVATE_KEY_B64=
# GITHUB_APP_INSTALLATION_ID=
# CREATIVE_KIT_REPO=tensalir/loop-asset-reviewer
# A tag, branch or commit to read instead of the newest creative-v* tag
# (a preview testing a kit pull request, or a rollback).
# CREATIVE_KIT_REF=
# The private bucket the pinned references are kept in, bytes unchanged.
# CREATIVE_PINS_BUCKET=creative-pins
# 0 hides every creative tool.
# CREATIVE_TOOLS_ENABLED=1
# Frontify pins are pulled with a read token: FRONTIFY_DOMAIN (e.g.
# loop.frontify.com) and FRONTIFY_API_TOKEN, as the Frontify client uses.

# ── Feedback on the Loop Creative plugin ─────────────────────────────────────
# A colleague's remark, filed from Claude as an issue in the plugin repository
# by Vesper's GitHub App (above), in their own name, after they saw the text.
# Signs the preview id so what is filed is what they saw (at least 32 random
# characters: openssl rand -base64 48). Different in Production and Preview.
# FEEDBACK_HMAC_SECRET=
# 0 stops filing; previews still work.
# FEEDBACK_SUBMIT_ENABLED=1
