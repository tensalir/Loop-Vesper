{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "functions": {
    "app/api/generate/process/route.ts": {
      "maxDuration": 300
    },
    "app/api/analyze/process/route.ts": {
      "maxDuration": 300
    },
    "app/api/timeline/render/process/route.ts": {
      "maxDuration": 300
    },
    "app/api/mcp/route.ts": {
      "maxDuration": 300
    },
    "app/api/mcp/[token]/route.ts": {
      "maxDuration": 300
    },
    "app/api/packaging/packets/[id]/generate/route.ts": {
      "maxDuration": 300
    },
    "app/api/packaging/packets/[id]/components/[componentId]/supplier-pdf/route.ts": {
      "maxDuration": 120
    },
    "app/api/packaging/packets/[id]/artwork/route.ts": {
      "maxDuration": 120
    },
    "app/api/packaging/packets/[id]/workbook/route.ts": {
      "maxDuration": 60
    },
    "app/api/packaging/import/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/mcp-jobs",
      "schedule": "* * * * *"
    }
  ]
}
